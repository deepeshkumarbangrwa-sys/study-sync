{
  "name": "padhsang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:production": "node scripts/sync-postgres-schema.mjs --check && prisma generate --schema prisma/postgres/schema.prisma && next build",
    "start": "next start",
    "start:production": "prisma migrate deploy --schema prisma/postgres/schema.prisma && next start --hostname 0.0.0.0",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:generate:production": "prisma generate --schema prisma/postgres/schema.prisma"
  },
  "engines": { "node": ">=22 <25" },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^5.22.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
