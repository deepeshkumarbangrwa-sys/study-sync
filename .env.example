# Copy this file to .env. Keep real secrets out of version control.
DATABASE_URL="file:./dev.db"

# Generate a random secret, then paste the output here:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth web application credentials (optional if using only Microsoft).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra app registration: client ID and client secret VALUE.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# Supports personal Microsoft accounts and work/school accounts.
# The app registration must also support these account types.
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/common/v2.0"
